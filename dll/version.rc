#include <winver.h>

#define TM_VERSION      1,3,1,0
#define TM_VERSION_STR  "1.3.1.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    TM_VERSION
 PRODUCTVERSION TM_VERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"          /* U.S. English, Unicode */
        BEGIN
            VALUE "CompanyName",      "XaviFlorit"
            VALUE "FileDescription",  "A Bit Better Traversal Movement - traversal mod for FINAL FANTASY VII REBIRTH (loads as dwmapi.dll)"
            VALUE "FileVersion",      TM_VERSION_STR
            VALUE "InternalName",     "TraversalMovement"
            VALUE "LegalCopyright",   "Copyright (C) 2026 XaviFlorit. MIT License. Not affiliated with Square Enix."
            VALUE "OriginalFilename", "dwmapi.dll"
            VALUE "ProductName",      "A Bit Better Traversal Movement"
            VALUE "ProductVersion",   TM_VERSION_STR
            VALUE "Comments",         "Source: https://github.com/xavitolavi/a-bit-better-traversal-movement"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0   /* U.S. English, Unicode code page */
    END
END
